# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Dados brutos: páginas compactadas (.jsonl.gz, ~13x menores) e manifest são versionados
# enquanto o recorte for pequeno (ADR-008); qualquer outra coisa em raw/ fica de fora
ml/raw/*
!ml/raw/.gitkeep
!ml/raw/*/
!ml/raw/**/
!ml/raw/**/*.jsonl.gz
!ml/raw/**/total_esperado.txt
!ml/raw/**/manifest.json

# Modelos treinados grandes (publicar o JSON derivado, não o pickle)
ml/models/*.pkl
ml/models/*.joblib

# Node / site
node_modules/
web/dist/
web/.vite/

# Sistema
.DS_Store
*.log
.ruff_cache/
