{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampulheta.local/contracts/curvas.schema.json",
  "title": "Ampulheta — curvas publicadas (contrato 1.0.0)",
  "type": "object",
  "required": ["contrato", "gerado_em", "snapshot", "sintetico", "fonte", "tribunal", "grau", "evento", "grade_meses", "varas", "classes", "curvas"],
  "additionalProperties": false,
  "properties": {
    "contrato": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "gerado_em": { "type": "string", "format": "date-time" },
    "snapshot": { "type": "string", "format": "date" },
    "sintetico": { "type": "boolean" },
    "fonte": {
      "type": "object",
      "required": ["nome", "url", "citacao"],
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "citacao": { "type": "string", "minLength": 1 }
      }
    },
    "tribunal": { "type": "string", "minLength": 2 },
    "grau": { "type": "string", "enum": ["G1", "G2"] },
    "evento": { "type": "string", "minLength": 1 },
    "grade_meses": {
      "type": "array", "minItems": 2,
      "items": { "type": "integer", "minimum": 0 }
    },
    "varas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codigo", "nome", "municipio"],
        "properties": {
          "codigo": { "type": "string", "minLength": 1 },
          "nome": { "type": "string", "minLength": 1 },
          "municipio": { "type": "string", "minLength": 1 }
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codigo", "nome"],
        "properties": {
          "codigo": { "type": "string", "minLength": 1 },
          "nome": { "type": "string", "minLength": 1 }
        }
      }
    },
    "curvas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vara", "classe", "metodo", "n", "eventos", "censurados", "sobrevivencia", "ic_inferior", "ic_superior", "quantis_meses"],
        "properties": {
          "vara": { "type": ["string", "null"] },
          "classe": { "type": ["string", "null"] },
          "metodo": { "type": "string", "enum": ["kaplan-meier"] },
          "n": { "type": "integer", "minimum": 1 },
          "eventos": { "type": "integer", "minimum": 0 },
          "censurados": { "type": "integer", "minimum": 0 },
          "sobrevivencia": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "ic_inferior": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "ic_superior": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
          "quantis_meses": {
            "type": "object",
            "required": ["p50", "p80", "p90"],
            "properties": {
              "p50": { "type": ["number", "null"], "minimum": 0 },
              "p80": { "type": ["number", "null"], "minimum": 0 },
              "p90": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
